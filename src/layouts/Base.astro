---
import '../styles/global.css';
import site from '../content/site.json';

interface Props {
  title: string;
  description: string;
  mdPath: string; // 例: 'index.md'
  showNav?: boolean;
}
const { title, description, mdPath, showNav = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const home = base;
const canonical = new URL(Astro.url.pathname.replace(base, '/'), site.meta.url).toString();
const navHref = (h: string) => (showNav ? h : `${home}${h}`);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" type="text/markdown" href={`${base}${mdPath}`} title="Markdown版" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.meta.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', site.meta.url).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Noto+Sans+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#main">本文へ移動</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={home} aria-label={`${site.meta.siteName} トップへ`}>
          <img src={`${base}logo.svg`} alt="Coralca コラルカ" width="140" height="36" />
        </a>
        <nav class="gnav" aria-label="ページ内">
          <ul>
            {site.nav.map((n) => (<li><a href={navHref(n.href)}>{n.label}</a></li>))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <ul>
          <li><a href={`${home}#company`}>会社概要</a></li>
          <li><a href={`${home}privacy/`}>プライバシーポリシー</a></li>
          <li><a href={`${base}llms.txt`}>llms.txt</a></li>
        </ul>
        <small>{site.footer.copyright}</small>
      </div>
    </footer>

  </body>
</html>
